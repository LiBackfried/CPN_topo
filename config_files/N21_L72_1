# theory parameters
size   72 72    # L_t L_x
beta   0.6      # bare inverse coupling
theta  0.0      # bare imaginary theta

# simulation details
num_MC_step      40     # number of updating steps; in the nested sampling setting, use for thermalization  
meas_every       8      # perform measures every <meas_every> steps => important for intializing the heatbath live points    should have every 8th or 10th in this setting
num_micro        4      # number of over-relaxation steps (microcanonical steps) for every over-heat-bath step
num_norm         1      # normalize fields every <num_norm> steps
save_conf_every  1      # save conf for backup every <save_conf_every> steps

start 1                 # initialize conf: 0=random cold, 1=random hot, 2=start from saved conf

num_cool_step    50     # number of cooling steps 
meas_cool_every  5      # perform measures every <meas_cool_every> cool steps

rng_seed  6775           # rng seed    (42)
rng_start 0             # initialize rng state: 0=std initialization, 1=read rng state from file

# Hasenbusch parallel tempering parameters
num_replica  1    # number of replicas
defect_size  0    # defect length
hierarc_upd  0    # number of hierarchic update __ rectangle sizes for each herarchic level __ number of sweeps for each hierarchic level

# multicanonic parameters
grid_step 1                      # topo potential is defined on a grid with step <grid_step>
grid_max 100                     # topo potential is defined for Q € [ -<grid_max>, <grid_max> ], outside is just taken constant
# num_smooth_step 0                # number of smoothing steps to define topo charge in topo potential
num_single_site_stoc_upd 2500    # number of stochastic single sites updates

# nested sampling parameters
num_live_pts 1000        # number of livepoints for the nested sampling
num_ns_meas 20000        # number of nested sampling updates
save_dead 0         # switch to save dead configs themselves, 0=dont save, any other integer=save

# file names
conf_file                 out_data/res_5/conf.dat                # save conf for backup
data_file                 out_data/res_5/dati.dat                # save non-topological observables
topo_file                 out_data/res_5/topo.dat                # save topological observables
log_file                  out_data/res_5/my_log.dat              # save simulations details
rng_state_file            out_data/res_5/rng_state.dat           # save rng state
swap_acc_file             out_data/res_5/swap_acc.dat            # save swap acceptances (parallel tempering only)
swap_track_file           out_data/res_5/swap_track.dat          # keep track of swaps (parallel tempering only)
topo_potential_file       out_data/res_5/topo_potential          # read topo potential (multicanonic only)
multicanonic_acc_file     out_data/res_5/multicanonic_acc.dat    # save multicanonic acceptances (multicanonic only)
