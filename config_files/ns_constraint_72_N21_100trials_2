# CP^(20) nested-sampling constraint benchmark: 72x72, 100 constraint trials/update.
size 72 72
beta 0.6
theta 0.0

num_MC_step 20
meas_every 8
num_micro 2
num_norm 1
save_conf_every 1
start 1

num_cool_step 50
meas_cool_every 5

rng_seed 6770
rng_start 0

num_replica 1
defect_size 0
hierarc_upd 0

grid_step 1
grid_max 100
num_single_site_stoc_upd 2500

num_live_pts 50
num_ns_meas 1500
save_dead 0

# The runner changes into a dedicated output directory, so these remain isolated.
conf_file conf.dat
data_file dati.dat
topo_file topo.dat
live_energy_file live_energy.dat
log_file log.dat
rng_state_file rng_state.dat
swap_acc_file swap_acc.dat
swap_track_file swap_track.dat
topo_potential_file topo_potential
multicanonic_acc_file multicanonic_acc.dat
